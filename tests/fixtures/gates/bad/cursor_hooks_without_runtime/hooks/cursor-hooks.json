{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/broker_write_gate.py\"",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/broker_write_gate.py\" --runtime cursor",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
